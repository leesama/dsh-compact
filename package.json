{
  "name": "dsh-compact",
  "version": "0.1.0",
  "description": "Compaction telemetry & shadow-cost reporting for DeepSeek Harness: tracks every compaction's shadowed tokens, summary cost, and model, with a /compact-stats report.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "compaction",
    "context-engineering",
    "telemetry"
  ],
  "license": "MIT",
  "author": "leesama <leesher9421@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leesama/dsh-compact.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run e2e",
    "test:package": "npm run build && node --test test/package.test.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
